---
import { TextImage } from '../components/media';
import { TextBlock } from '../components/text';
import HeroBackground from '../components/hero/HeroBackground.astro';
import BusinessLayout from '../layouts/BusinessLayout.astro';
import { footerContent } from '../config/footerContent';
---

<BusinessLayout
	title="Nuestra meta"
	description={footerContent.columns.mission}
>
	<HeroBackground
		align="center"
		image="/img/2018/12/fondocarper.png"
		title="Nuestra meta"
		description={footerContent.columns.mission}
		showbutton={false}
	/>
	<TextImage reverse height="auto" />
	<TextBlock align="center" />
</BusinessLayout>
