---
import BusinessLayout from './BusinessLayout.astro';
import Container from '../components/ui/Container.astro';
import HeroBackground from '../components/hero/HeroBackground.astro';
import LegalTemplateNotice from '../components/ui/LegalTemplateNotice.astro';
import { legalPagesContent } from '../config/legalContent';
import type { SeoProps } from '../lib/seo';

/**
 * For the legal pages under `src/pages/legal/` — wraps `BusinessLayout` with
 * the "incomplete template" warning banner and a consistent `<h1>` +
 * "last updated" line, so each legal page's `.astro` file only needs to
 * contain its actual `<h2>` sections (passed as the default slot).
 */
export interface Props extends SeoProps {
	/** Visible `<h1>`. Defaults to the SEO `title`. */
	heading?: string;
}

const { heading, ...seoProps } = Astro.props;
const { title } = seoProps;
const resolvedHeading = heading ?? title;
---

<BusinessLayout {...seoProps}>
	<HeroBackground
		align="center"
		image="/img/2018/12/fondocarper.png"
		title={resolvedHeading}
		description="Información legal de Carper Sonido Profesional en Vigo y Pontevedra."
		showbutton={false}
	/>
	<section>
		<Container narrow>
			{legalPagesContent.showTemplateNotice !== false && <LegalTemplateNotice />}
			<p>Última actualización: {legalPagesContent.lastUpdated}</p>
			<slot />
		</Container>
	</section>
</BusinessLayout>
