---
import BusinessLayout from './BusinessLayout.astro';
import ServiceSchema from '../components/seo/ServiceSchema.astro';
import HeroBackground from '../components/hero/HeroBackground.astro';
import type { Service } from '../config/servicesContent';
import type { SeoProps } from '../lib/seo';

/**
 * For individual service detail pages (`src/pages/services/[slug].astro`,
 * and any future service-related page, e.g. a case study) — wraps
 * `BusinessLayout` with the `Service` JSON-LD, so that wiring only needs
 * to happen once.
 */
export interface Props extends Omit<SeoProps, 'title' | 'description'> {
	service: Service;
	/** SEO title override. Defaults to `service.title`. */
	title?: string;
	/** SEO description override. Defaults to `service.description`. */
	description?: string;
}

const { service, title, description, ...seoProps } = Astro.props;
const heroTitle = title ?? service.seoTitle ?? service.title;
const heroDescription = description ?? service.seoDescription ?? service.description;
---

<BusinessLayout
	title={heroTitle}
	description={heroDescription}
	{...seoProps}
>
	<ServiceSchema
		name={heroTitle}
		description={heroDescription}
		url={`/services/${service.slug}`}
		image={service.image}
	/>
	<HeroBackground
		align="center"
		image={service.image ?? service.homeImage}
		video={service.heroVideo}
		title={heroTitle}
		description={heroDescription}
		primaryCtaText="Solicitar presupuesto"
		primaryCtaHref="/contacto"
		secondaryCtaText="Ver servicios"
		secondaryCtaHref="/services"
	/>
	<slot />
</BusinessLayout>
