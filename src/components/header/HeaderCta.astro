---
import Container from '../ui/Container.astro';
import Icon from '../ui/Icon.astro';
import BrandMark from '../ui/BrandMark.astro';
import { business } from '../../config/business';
import { mainNavigation } from '../../config/navigation';
import { backgroundStyle, type BackgroundProps } from '../../lib/background';
import NavMenu from './NavMenu.astro';

export interface Props extends BackgroundProps {
	logo?: string;
	logoAlt?: string;
}

const {
	logo = business.logo,
	logoAlt = business.name,
	backgroundColor,
	backgroundImage,
} = Astro.props;
const style = backgroundStyle({ backgroundColor, backgroundImage });
const phoneHref = `tel:${business.phone.replace(/[^\d+]/g, '')}`;
---

<header class="header-cta" style={style}>
	<Container class="header-cta__inner">
		<a href="/" class="header-cta__brand">
			<BrandMark logo={logo} logoAlt={logoAlt} variant="dark" class="header-cta__logo" />
		</a>
		<nav class="header-cta__nav" aria-label="Navegación principal">
			<NavMenu items={mainNavigation} align="center" />
		</nav>
		<a class="header-cta__phone" href={phoneHref}>
			<Icon name="phone" size={16} />
			{business.phone}
		</a>
	</Container>
</header>

<style>
	.header-cta {
		position: sticky;
		top: 0;
		z-index: 80;
		color: var(--color-on-media);
		background-color: #121212;
		/* Dark chrome: NavMenu, buttons and dropdowns inherit these tokens. */
		--color-background: #121212;
		--color-surface: #1a1a1a;
		--color-text: #e0e0e0;
		--color-text-muted: #b0b0b0;
		--color-border: #444444;
	}

	:global(.header-cta__inner) {
		display: flex;
		align-items: center;
		gap: var(--spacing-md);
		padding-block: var(--spacing-sm);
		min-width: 0;
	}

	.header-cta__brand {
		flex: 1 1 0;
		min-width: 0;
		display: flex;
		justify-content: flex-start;
		font-weight: bold;
		font-size: 1.25rem;
	}

	/* :global() because the `<img>` is now rendered by the `BrandMark` child component, which is outside this component's scoped-CSS boundary. */
	:global(.header-cta__logo) {
		height: 3.4rem;
		width: auto;
		max-width: min(9.5rem, 42vw);
	}

	.header-cta__nav {
		flex: 0 1 auto;
		display: flex;
		justify-content: center;
		min-width: 0;
	}

	.header-cta__phone {
		flex: 1 1 0;
		min-width: 0;
		display: inline-flex;
		align-items: center;
		justify-content: flex-end;
		gap: 0.45rem;
		color: var(--color-on-media);
		font-weight: 600;
		font-size: 0.95rem;
		letter-spacing: 0.02em;
		line-height: 1;
		text-decoration: none;
		white-space: nowrap;
		transition: color 0.2s ease;
	}

	.header-cta__phone:hover {
		color: var(--color-accent);
	}

	.header-cta__phone :global(.icon) {
		color: inherit;
	}

	@media (max-width: 980px) {
		:global(.header-cta__inner) {
			gap: 0.45rem;
		}

		.header-cta__nav {
			flex: 0 0 auto;
			order: 3;
			margin-left: 0;
		}

		.header-cta__phone {
			flex: 0 0 auto;
			margin-left: auto;
			font-size: 0.85rem;
		}
	}

	@media (max-width: 420px) {
		.header-cta__phone {
			font-size: 0.8rem;
			gap: 0.3rem;
		}
	}
</style>
