---
export type ButtonVariant = 'primary' | 'secondary' | 'outline' | 'ghost' | 'link' | 'inverse' | 'inverse-outline' | 'accent';
export type ButtonSize = 'sm' | 'md' | 'lg';

export interface Props {
	/** Renders an `<a>` when provided, otherwise a `<button>`. */
	href?: string;
	type?: 'button' | 'submit' | 'reset';
	variant?: ButtonVariant;
	size?: ButtonSize;
	fullWidth?: boolean;
	class?: string;
	target?: string;
	rel?: string;
	/**
	 * Fires this standard analytics event (see `src/lib/analytics.ts`) on
	 * click, via a global delegated listener — no extra script needed here.
	 * Never fires anything until the visitor has granted analytics consent.
	 */
	track?: 'cta_click' | 'whatsapp_click' | 'phone_click' | 'email_click';
	/** Optional context sent alongside `track`, e.g. the button's own text. */
	trackLabel?: string;
}

const {
	href,
	type = 'button',
	variant = 'primary',
	size = 'md',
	fullWidth = false,
	class: className,
	target,
	rel,
	track,
	trackLabel,
} = Astro.props;

const classes = ['btn', `btn--${variant}`, `btn--${size}`, fullWidth && 'btn--full', className];
---

{
	href ? (
		<a
			class:list={classes}
			href={href}
			target={target}
			rel={target === '_blank' ? (rel ?? 'noopener noreferrer') : rel}
			data-track-event={track}
			data-track-label={trackLabel}
		>
			<slot />
		</a>
	) : (
		<button class:list={classes} type={type} data-track-event={track} data-track-label={trackLabel}>
			<slot />
		</button>
	)
}

<style>
	.btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		align-self: start;
		justify-self: start;
		box-sizing: border-box;
		gap: 0.5rem;
		width: 16rem;
		min-width: 16rem;
		min-height: 3rem;
		padding: 0.75rem 1.5rem;
		border-radius: var(--radius-base);
		border: 1px solid transparent;
		font: inherit;
		font-size: 0.95rem;
		font-weight: 600;
		line-height: 1.2;
		text-align: center;
		text-decoration: none;
		white-space: nowrap;
		cursor: pointer;
		transition:
			opacity 0.2s ease,
			transform 0.2s ease,
			background-color 0.2s ease,
			color 0.2s ease,
			border-color 0.2s ease;
	}

	.btn:hover {
		opacity: 0.92;
		transform: translateY(-1px);
	}

	.btn:active {
		transform: translateY(0);
	}

	.btn--sm,
	.btn--md,
	.btn--lg {
		min-width: 16rem;
		min-height: 3rem;
		padding: 0.75rem 1.5rem;
		font-size: 0.95rem;
	}

	.btn--primary {
		background-color: var(--color-text);
		color: var(--color-background);
	}

	.btn--secondary {
		background-color: var(--color-surface);
		color: var(--color-text);
		border-color: var(--color-border);
	}

	.btn--outline {
		background-color: transparent;
		/* `--color-text-muted`, not `--color-border`: this border is the only
		   visual boundary of this variant, so it needs the ~3:1 non-text
		   contrast a UI component's boundary requires (WCAG 1.4.11). */
		border-color: var(--color-text-muted);
		color: var(--color-text);
	}

	.btn--ghost {
		background-color: transparent;
		color: var(--color-text);
	}

	.btn--link {
		width: auto;
		min-width: 0;
		min-height: 0;
		padding: 0;
		background-color: transparent;
		color: var(--color-text);
		font-size: inherit;
	}

	.btn--link:hover {
		opacity: 1;
		transform: none;
		text-decoration: underline;
	}

	/* For use on dark/colored backgrounds (e.g. HeroBackground). */
	.btn--inverse {
		background-color: var(--color-on-media);
		color: var(--color-inverse);
	}

	.btn--accent {
		background-color: var(--color-accent);
		color: var(--color-inverse);
	}

	.btn--inverse-outline {
		background-color: transparent;
		border-color: color-mix(in srgb, var(--color-on-media) 70%, transparent);
		color: var(--color-on-media);
	}

	.btn--full {
		width: 100%;
		min-width: 0;
		align-self: stretch;
		justify-self: stretch;
	}

	.btn:disabled {
		opacity: 0.6;
		cursor: not-allowed;
		transform: none;
	}
</style>
