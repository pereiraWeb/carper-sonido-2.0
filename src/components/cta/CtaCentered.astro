---
import Container from '../ui/Container.astro';
import Button from '../ui/Button.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import { ctaContent } from '../../config/ctaContent';
import { backgroundStyle, type BackgroundProps } from '../../lib/background';

export interface Props extends BackgroundProps {
	eyebrow?: string;
	title?: string;
	description?: string;
	ctaText?: string;
	ctaHref?: string;
	secondaryCtaText?: string;
	secondaryCtaHref?: string;
	/** Background image URL. Alias for `backgroundImage`. */
	image?: string;
	/** Any valid CSS length (e.g. "auto", "320px", "50vh"). */
	height?: string;
}

const {
	eyebrow = ctaContent.centered.eyebrow,
	title = ctaContent.centered.title,
	description = ctaContent.centered.description,
	ctaText = ctaContent.centered.ctaText,
	ctaHref = ctaContent.centered.ctaHref,
	secondaryCtaText = ctaContent.centered.secondaryCtaText,
	secondaryCtaHref = ctaContent.centered.secondaryCtaHref,
	height = ctaContent.centered.height,
	image = ctaContent.centered.image,
	backgroundColor,
	backgroundImage = image,
} = Astro.props;

const style = backgroundStyle({ backgroundColor, backgroundImage }, { '--cta-centered-height': height });
---

<section class="cta-centered" style={style}>
	<div class="cta-centered__overlay" aria-hidden="true"></div>
	<Container class="cta-centered__inner">
	<SectionHeading
		eyebrow={eyebrow}
		eyebrowClass="cta-centered__eyebrow"
		title={title}
		titleClass="cta-centered__title"
		description={description}
		descriptionClass="cta-centered__description"
	/>
		<div class="cta-centered__actions">
			<Button href={ctaHref} variant="inverse" track="cta_click" trackLabel={ctaText}>{ctaText}</Button>
			{secondaryCtaText && <Button href={secondaryCtaHref} variant="inverse-outline">{secondaryCtaText}</Button>}
		</div>
	</Container>
</section>

<style>
	.cta-centered {
		position: relative;
		width: 100%;
		min-height: var(--cta-centered-height, auto);
		display: flex;
		align-items: center;
		justify-content: center;
		padding-block: var(--spacing-xl);
		background-color: #121212;
		color: var(--color-on-media);
		text-align: center;
	}

	.cta-centered__overlay {
		position: absolute;
		inset: 0;
		z-index: 0;
		pointer-events: none;
		background:
			linear-gradient(180deg, rgba(18, 18, 18, 0.43) 0%, rgba(18, 18, 18, 0.93) 100%),
			var(--color-bg-overlay);
	}

	:global(.cta-centered__inner) {
		position: relative;
		z-index: 1;
		display: flex;
		flex-direction: column;
		align-items: center;
	}

	/* :global() below because these are now rendered by the `SectionHeading` child component, outside this component's scoped-CSS boundary. */
	:global(.cta-centered__eyebrow) {
		display: inline-block;
		margin-bottom: var(--spacing-xs);
		color: var(--color-accent);
		font-size: 0.85rem;
		font-weight: 700;
		letter-spacing: 0.05em;
		text-transform: uppercase;
	}

	:global(.cta-centered__eyebrow)::after {
		content: '';
		display: block;
		width: 2.25rem;
		height: 2px;
		margin-top: 0.45rem;
		margin-inline: auto;
		background: var(--color-accent);
	}

	:global(.cta-centered__title) {
		color: var(--color-on-media);
		font-size: clamp(1.75rem, 4vw, 2.75rem);
		line-height: 1.2;
	}

	:global(.cta-centered__description) {
		max-width: 560px;
		margin-top: var(--spacing-xs);
		color: var(--color-on-media-muted);
		font-size: 1.1rem;
	}

	.cta-centered__actions {
		display: inline-grid;
		grid-auto-flow: column;
		grid-auto-columns: 1fr;
		justify-content: center;
		gap: var(--spacing-sm);
		margin-top: var(--spacing-md);
		max-width: 100%;
	}

	.cta-centered__actions :global(.btn) {
		width: 100%;
	}

	@media (max-width: 520px) {
		.cta-centered__actions {
			grid-auto-flow: row;
			width: 100%;
			max-width: 16rem;
		}
	}
</style>
