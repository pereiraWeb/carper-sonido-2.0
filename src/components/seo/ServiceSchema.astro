---
import { business, geoCoordinates, serviceAreas } from '../../config/business';

export interface Props {
	name: string;
	description: string;
	/** Root-relative or absolute URL of this service's own page. */
	url: string;
	image?: string;
}

const { name, description, url, image } = Astro.props;

const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'Service',
	name,
	description,
	url: new URL(url, business.siteUrl).toString(),
	image: image ? new URL(image, business.siteUrl).toString() : undefined,
	serviceType: name,
	areaServed: serviceAreas.map((area) => ({
		'@type': area.type,
		name: area.name,
	})),
	provider: {
		'@type': 'LocalBusiness',
		name: business.name,
		url: business.siteUrl,
		telephone: business.phone,
		email: business.email,
		address: {
			'@type': 'PostalAddress',
			streetAddress: business.address.street,
			addressLocality: business.address.city,
			addressRegion: business.address.region,
			postalCode: business.address.postalCode,
			addressCountry: business.address.country,
		},
		geo: {
			'@type': 'GeoCoordinates',
			latitude: geoCoordinates.latitude,
			longitude: geoCoordinates.longitude,
		},
	},
};
---

<script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
