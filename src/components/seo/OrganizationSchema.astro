---
import { business, serviceAreas } from '../../config/business';

/**
 * Site-wide `Organization` JSON-LD, identifying the publisher behind every
 * page. Rendered once, globally, by `BusinessLayout.astro`.
 */
const sameAs = Object.values(business.social).filter((url): url is string => Boolean(url));

const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'Organization',
	name: business.name,
	legalName: business.legalName,
	url: business.siteUrl,
	logo: business.logo ? new URL(business.logo, business.siteUrl).toString() : undefined,
	description: business.description,
	email: business.email,
	telephone: business.phone,
	address: {
		'@type': 'PostalAddress',
		streetAddress: business.address.street,
		addressLocality: business.address.city,
		addressRegion: business.address.region,
		postalCode: business.address.postalCode,
		addressCountry: business.address.country,
	},
	areaServed: serviceAreas.map((area) => ({
		'@type': area.type,
		name: area.name,
	})),
	...(sameAs.length > 0 ? { sameAs } : {}),
};
---

<script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
